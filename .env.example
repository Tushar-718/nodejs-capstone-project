# Application
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
# Matches docker-compose.yml port mapping 5440:5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/nodejs-capstone?sslmode=disable

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_ACCESS_EXPIRES_IN=1d

# Redis
# Matches docker-compose.yml port mapping 6385:6379
REDIS_URL=redis://localhost:6385

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
